{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "VSHelpDesk",
    "Audience": "VSHelpDesk",
    "SigningKey": "",
    "ExpirationMinutes": 480
  },
  "Email": {
    "ReceiverMode": "Fake",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUseSsl": false,
    "ImapHost": "",
    "ImapPort": 993,
    "ImapUseSsl": true,
    "Username": "",
    "Password": "",
    "SupportMailboxAddress": "support@vshelpdesk.local",
    "SupportMailboxDisplayName": "VS Help Desk",
    "SendSmtpProbeOnProcessJob": false
  },
  "FileStorage": {
    "RootPath": "storage",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/webp",
      "text/plain",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    ]
  },
  "Jobs": {
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:5173",
      "http://localhost:5173"
    ]
  }
}
