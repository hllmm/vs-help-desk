# Copy to .env (never commit .env).
# Required for docker compose (dev and prod).

# PostgreSQL
POSTGRES_PASSWORD=choose-a-strong-local-password
POSTGRES_USER=stajyer
POSTGRES_DB=VS_HelpDesk_DB

# API — production compose
AUTH_SIGNING_KEY=replace-with-random-utf8-key-at-least-32-bytes-long
JOBS_API_KEY=replace-with-random-job-key-16plus
# Host header accepted by ASP.NET Core. Do not use * in production.
ALLOWED_HOSTS=helpdesk.example.com
# Leave blank when nginx serves frontend and /api from the same origin.
# Set only when the frontend is hosted on another origin.
CORS_ALLOWED_ORIGIN=
# Optional portal publish port (default 8080)
# WEB_PUBLISH_PORT=8080

# Email — production requires real company SMTP/IMAP credentials
EMAIL_RECEIVER_MODE=Imap
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURITY=StartTls
EMAIL_SMTP_USERNAME=support@example.com
EMAIL_SMTP_PASSWORD=replace-with-real-smtp-password
EMAIL_SUPPORT_MAILBOX_ADDRESS=support@example.com
EMAIL_SUPPORT_MAILBOX_DISPLAY_NAME="VS Help Desk"
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURITY=SslOnConnect
EMAIL_IMAP_USERNAME=support@example.com
EMAIL_IMAP_PASSWORD=replace-with-real-imap-password
EMAIL_IMAP_ACCOUNT_ID=support@example.com
EMAIL_IMAP_FOLDER=INBOX
# Required when EMAIL_RECEIVER_MODE=Imap — MTA authserv-id that signs Authentication-Results (e.g. mx.example.com); startup fails if empty when Imap
EMAIL_TRUSTED_AUTHSERV_ID=change-me-mx.example.com

# Corporate email branding. Logo is optional and is never bundled in the repository.
# When provided, LogoUrl must be an absolute HTTPS URL.
EMAIL_BRANDING_COMPANY_NAME="VS Help Desk"
EMAIL_BRANDING_SYSTEM_NAME="Corporate Customer Support System"
EMAIL_BRANDING_LOGO_URL=
EMAIL_BRANDING_REQUIRE_LOGO=false
EMAIL_BRANDING_WEBSITE_URL=
EMAIL_BRANDING_ADDRESS=
EMAIL_BRANDING_SUPPORT_EMAIL=support@example.com
EMAIL_BRANDING_SUPPORT_PHONE=
EMAIL_BRANDING_PRIMARY_COLOR="#2563eb"
EMAIL_BRANDING_HEADER_GRADIENT_START="#1e293b"
EMAIL_BRANDING_HEADER_GRADIENT_END="#0f172a"
EMAIL_BRANDING_FOOTER_TEXT="© 2026 VS Help Desk. All rights reserved."

# Local API (dotnet run) — prefer user-secrets:
#   cd src/VSHelpDesk.WebAPI
#   dotnet user-secrets set "Auth:SigningKey" "..."
#   dotnet user-secrets set "Jobs:ApiKey" "..."
#   dotnet user-secrets set "SeedAdmin:Enabled" "true"
#   dotnet user-secrets set "SeedAdmin:FullName" "<admin-full-name>"
#   dotnet user-secrets set "SeedAdmin:Username" "<admin-username>"
#   dotnet user-secrets set "SeedAdmin:Email" "<admin-email>"
#   dotnet user-secrets set "SeedAdmin:Password" "<admin-password>"
#   dotnet user-secrets set "Email:SupportMailboxAddress" "<support-mailbox>"
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=VS_HelpDesk_DB;Username=stajyer;Password=..."
